#version 430 core

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer Links { uint links[]; };
layout(std430, binding = 1) readonly buffer Current { vec4 currentWind[]; };
layout(std430, binding = 2) buffer Next { vec4 nextWind[]; };

struct Source {
    ivec4 address;
    vec4 vector;
};
layout(std430, binding = 3) readonly buffer Sources { Source sources[]; };
layout(std430, binding = 4) readonly buffer OldLabels { int oldLabels[]; };

uniform int phase;
uniform int sourceCount;
uniform ivec3 shift;

const float MIN_WIND = 0.004;
const int WIND_PLANE = WIND_SIDE * WIND_SIDE;
const int NODES = WIND_PLANE * WIND_SIDE * 4;
const ivec3 FACES[6] = ivec3[6](ivec3(1, 0, 0), ivec3(-1, 0, 0), ivec3(0, 1, 0),
    ivec3(0, -1, 0), ivec3(0, 0, 1), ivec3(0, 0, -1));
const int NODE_STRIDE[6] = int[6](4, -4, 4 * WIND_SIDE, -4 * WIND_SIDE, 4 * WIND_PLANE, -4 * WIND_PLANE);

vec4 bounded(vec3 vector) {
    float speed = length(vector);
    if (speed < MIN_WIND) return vec4(0);
    return speed > 1.0 ? vec4(vector / speed, 1.0) : vec4(vector, speed);
}

void rebase(int node, uint descriptor) {
    int cell = node / 4;
    ivec3 base = 2 * ivec3(cell % WIND_SIDE, (cell / WIND_SIDE) % WIND_SIDE, cell / WIND_PLANE) + shift;
    vec3 sum = vec3(0);
    float count = 0;
    for (uint part = descriptor >> 24; part != 0u; part &= part - 1u) {
        int bit = findLSB(part);
        ivec3 block = base + ivec3(bit & 1, (bit >> 1) & 1, bit >> 2);
        if (any(lessThan(block, ivec3(0))) || any(greaterThanEqual(block, ivec3(WIND_BLOCK_SIDE)))) continue;
        int old = oldLabels[VAPOR_OPEN_WORDS + block.x + WIND_BLOCK_SIDE * (block.y + WIND_BLOCK_SIDE * block.z)];
        if (old < 0) continue;
        sum += currentWind[old].xyz;
        count += 1.0;
    }
    nextWind[node] = bounded(sum / max(count, 1.0));
}

int findSource(int node) {
    int low = 0, high = sourceCount - 1;
    while (low <= high) {
        int middle = (low + high) / 2;
        int index = sources[middle].address.x;
        if (index == node) return middle;
        if (index < node) low = middle + 1;
        else high = middle - 1;
    }
    return -1;
}

void main() {
    int node = int(gl_GlobalInvocationID.x);
    if (phase == 2) {
        // Each work item owns a distinct node. An impulse affects the following propagation.
        if (node >= sourceCount) return;
        int at = sources[node].address.x;
        nextWind[at] = bounded(nextWind[at].xyz + sources[node].vector.xyz);
        return;
    }
    if (node >= NODES) return;
    uint descriptor = links[node];
    if (descriptor == 0u) {
        nextWind[node] = vec4(0);
        return;
    }
    if (phase == 1) {
        rebase(node, descriptor);
        return;
    }
    int source = findSource(node);
    if (source >= 0) {
        nextWind[node] = bounded(sources[source].vector.xyz);
        return;
    }

    vec3 target = vec3(0);
    float weights = 0;
    for (uint edges = descriptor & 0x00ffffffu; edges != 0u; edges &= edges - 1u) {
        int link = findLSB(edges);
        int face = link / 4;
        vec4 incoming = currentWind[node - (node & 3) + NODE_STRIDE[face] + (link & 3)];
        if (incoming.w <= MIN_WIND) continue;
        vec3 direction = vec3(FACES[face ^ 1]);
        float alignment = dot(incoming.xyz, direction) / incoming.w;
        float speed = (incoming.w - 0.012) * (0.78 + (alignment >= 0 ? 0.19 : 0.66) * alignment);
        if (speed <= MIN_WIND) continue;
        float bend = 0.72 * (1.0 - max(0.0, alignment));
        vec3 turned = incoming.xyz * ((1.0 - bend) / incoming.w) + direction * bend;
        float turnedLength = length(turned);
        if (turnedLength < MIN_WIND) continue;
        float weight = speed * speed;
        weight *= weight;
        target += turned * (speed * weight / turnedLength);
        weights += weight;
    }
    if (weights > 0.0) target /= weights;
    vec4 previous = currentWind[node];
    float response = 0.27 + 0.7 * max(previous.w, length(target));
    nextWind[node] = bounded(previous.xyz + (target - previous.xyz) * response);
}
